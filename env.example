PORT=5000

# LLM provider — swap this service out for whichever API you have a key for
ANTHROPIC_API_KEY=your_key_here
LLM_MODEL=claude-sonnet-4-6

# GitHub REST API — unauthenticated works but is rate-limited to 60 req/hr.
# Add a personal access token (no scopes needed for public data) to raise that to 5000/hr.
GITHUB_TOKEN=

JWT_SECRET=change_this_to_something_random
